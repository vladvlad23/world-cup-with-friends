# Production environment template.
# Copy to `.env` on your server (next to docker-compose.yml) and fill in the
# values marked CHANGE ME. Compose loads `.env` automatically.
#
#   cp .env.production.example .env
#   # edit the values below
#   docker compose up -d --build

# --- Postgres ---
POSTGRES_USER=worldcup
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=worldcup

# --- Auth (CHANGE ME) ---
# Secret used to sign login JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# --- Public URL (CHANGE ME) ---
# The EXACT origin the browser uses to reach the app, including scheme and any
# non-standard port. adapter-node uses this for SvelteKit's CSRF check; if it is
# wrong the app loads but every login fails with HTTP 403.
#   - Behind TLS reverse proxy on 443:  https://meetups.yourdomain.com  (no port)
#   - Direct, exposing port 3000:        http://your.server.ip:3000
PUBLIC_ORIGIN=https://meetups.yourdomain.com

# --- Host ports ---
# Port the frontend is published on. Behind a reverse proxy you typically keep
# this internal and let the proxy terminate TLS on 443.
FRONTEND_PORT=3000

# Port the Go API is published on. NOTE: the frontend reaches the backend over
# the internal Docker network (http://backend:8080), so the backend does NOT
# need a public port. For a tighter setup, remove the backend `ports:` block in
# docker-compose.yml entirely; this value only matters if you keep it for debugging.
BACKEND_PORT=8080

# --- Users ---
# Real users are NOT committed to git. Copy users.example.json to users.json,
# edit it with real usernames + strong passwords, and start with the prod overlay
# so it gets mounted and seeded:
#   cp users.example.json users.json
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# (The overlay sets USERS_FILE=/config/users.json and mounts ./users.json.)

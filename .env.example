# Copy to .env and adjust. docker-compose reads this automatically.
POSTGRES_USER=worldcup
POSTGRES_PASSWORD=worldcup
POSTGRES_DB=worldcup

# Secret used to sign login JWTs. CHANGE THIS in production.
JWT_SECRET=change-me-in-production

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Public URL users reach the frontend on. Must match FRONTEND_PORT.
# Change this to your domain (e.g. https://meetups.example.com) when deploying.
PUBLIC_ORIGIN=http://localhost:3000
